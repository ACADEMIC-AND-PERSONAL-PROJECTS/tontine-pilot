{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": false,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  // functions/ excluded: their deps come from each function's own
  // package.json and $amplify/env/* types are generated by `ampx sandbox`
  // at deploy time. Handler logic is covered by vitest via _shared modules.
  "exclude": ["node_modules", "dist", "functions"]
}
